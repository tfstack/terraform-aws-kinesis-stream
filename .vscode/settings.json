{
  "files.associations": {
    "*.dockerfile": "dockerfile",
    "*.sh.tpl": "shellscript",
    "docker-compose*.yml": "yaml",
    "Dockerfile*": "dockerfile",
    "*.py.tpl": "python",
    "*.yaml.tpl": "yaml",
    "*.yml.tpl": "yaml",
    "*.tf": "terraform",
    "*.tfvars": "terraform"
  },
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "__debug_bin": true,
    "vendor/": true,
    "go.sum": true,
    "**/node_modules": true,
    "**/.terraform": true,
    "**/.terragrunt-cache": true,
    "**/Thumbs.db": true,
    "**/*.tfstate": true,
    "**/*.tfstate.*": true
  },
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",
  "remote.extensionKind": {
    "ms-azuretools.vscode-docker": "ui",
    "ms-vscode-remote.remote-containers": "ui"
  },
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.rulers": [79],
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 79,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.trimAutoWhitespace": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "prettier.requireConfig": true,
  "workbench.iconTheme": "vscode-icons",
  "workbench.colorTheme": "Visual Studio Dark",
  "[css]": {
    "editor.defaultFormatter": "vscode.css-language-features",
    "editor.foldingStrategy": "indentation"
  },
  "[dockerfile]": {
      "editor.defaultFormatter": "ms-azuretools.vscode-docker"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[json]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[jsonc]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[shellscript]": {
    "editor.defaultFormatter": "foxundermoon.shell-format"
  },
  "[terraform]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "davidanson.vscode-markdownlint",
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.wordWrap": "on",
    "editor.quickSuggestions": {
      "comments": "off",
      "strings": "off",
      "other": "off"
    }
  },
  "[yaml]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "[yml]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.insertSpaces": true,
    "editor.tabSize": 2
  },
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "terminal.integrated.defaultProfile.linux": "bash",
  "terminal.integrated.copyOnSelection": true,
  "search.exclude": {
    "**/node_modules": true,
    "**/bower_components": true,
    "**/*.code-search": true
  },
  "markdown.extension.toc.levels": "2..6",
  "markdown.extension.print.absoluteImgPath": false,
  "markdownlint.enable": true,
  "markdownlint.config": {
    "MD013": false,
    "MD033": false,
    "MD041": false,
    "MD024": { "siblings_only": true },
    "MD029": { "style": "ordered" },
    "MD007": { "indent": 2 },
    "MD012": { "maximum": 1 },
    "MD022": false,
    "MD025": false,
    "MD026": { "punctuation": ".,;:!" },
    "MD031": true,
    "MD032": true,
    "MD040": false,
    "MD047": true
  },
  "cSpell.enabled": true,
  "cSpell.enableFiletypes": [
    "markdown",
    "plaintext",
    "terraform",
    "yaml",
    "json"
  ],
  "cSpell.words": [
    "firehose",
    "kinesis",
    "terraform",
    "aws",
    "cloudwatch",
    "s3",
    "iam",
    "arn",
    "buffering",
    "compression",
    "gzip",
    "snappy",
    "parquet",
    "timestamp",
    "prefix",
    "tfstack"
  ],
  "cSpell.ignorePaths": [
    "**/.git/**",
    "**/node_modules/**",
    "**/.terraform/**",
    "**/*.tfstate*",
    "**/vendor/**"
  ],
  "yaml.format.enable": true,
  "yaml.format.singleQuote": false,
  "yaml.format.bracketSpacing": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/.terraform/**": true,
    "**/.terragrunt-cache/**": true
  },
  "terraform.format.enable": true,
  "terraform.lint.enable": true,
  "todo-tree.general.tags": [
    "BUG",
    "HACK",
    "FIXME",
    "TODO",
    "XXX",
    "[ ]",
    "[x]"
  ],
  "todo-tree.highlights.customHighlight": {
    "TODO": {
      "icon": "check",
      "type": "tag",
      "foreground": "red",
      "background": "white",
      "opacity": 50,
      "iconColour": "blue"
    },
    "FIXME": {
      "icon": "alert",
      "type": "tag",
      "foreground": "red",
      "background": "white",
      "opacity": 50,
      "iconColour": "red"
    }
  },
  "errorLens.enabledDiagnosticLevels": [
    "error",
    "warning",
    "info"
  ],
  "errorLens.messageEnabled": true,
  "errorLens.statusBarMessageEnabled": true,
  "errorLens.gutterIconsEnabled": true,
  "errorLens.messageTemplate": "$severity $count",
  "errorLens.statusBarMessageTemplate": "$severity $count",
  "gitlens.codeLens.enabled": true,
  "gitlens.currentLine.enabled": true,
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.blame.ignoreWhitespace": true,
  "gitlens.blame.compact": true,
  "gitlens.blame.format": "${author|10} ${date|2-} ${message|50}",
  "gitlens.statusBar.enabled": true,
  "gitlens.statusBar.alignment": "left",
  "gitlens.statusBar.command": "gitlens.showQuickRepoStatus",
  "gitlens.statusBar.pullRequests.enabled": true,
  "gitlens.statusBar.issues.enabled": true,
  "gitlens.statusBar.contributors.enabled": true,
  "gitlens.statusBar.avatars": true,
  "gitlens.statusBar.includeBuffers": true,
  "gitlens.statusBar.reduceFlicker": true,
  "gitlens.views.repositories.autoRefresh": true,
  "gitlens.views.fileHistory.enabled": true,
  "gitlens.views.lineHistory.enabled": true,
  "gitlens.views.branches.enabled": true,
  "gitlens.views.remotes.enabled": true,
  "gitlens.views.stashes.enabled": true,
  "gitlens.views.tags.enabled": true,
  "gitlens.views.contributors.enabled": true,
  "gitlens.views.compare.enabled": true,
  "gitlens.views.search.enabled": true,
  "gitlens.views.pullRequests.enabled": true,
  "gitlens.views.mergeRequests.enabled": true,
  "gitlens.views.issues.enabled": true,
  "gitlens.views.worktrees.enabled": true,
  "gitlens.views.graph.enabled": true,
  "gitlens.views.repositories.showBranchComparison": true,
  "gitlens.views.repositories.showIncomingActivity": true,
  "gitlens.views.repositories.showOutgoingActivity": true,
  "gitlens.views.repositories.showTags": true,
  "gitlens.views.repositories.showStashes": true,
  "gitlens.views.repositories.showRemotes": true,
  "gitlens.views.repositories.showBranches": true,
  "gitlens.views.repositories.showContributors": true,
  "gitlens.views.repositories.showFileHistory": true,
  "gitlens.views.repositories.showLineHistory": true,
  "gitlens.views.repositories.showSearch": true,
  "gitlens.views.repositories.showCompare": true,
  "gitlens.views.repositories.showPullRequests": true,
  "gitlens.views.repositories.showMergeRequests": true,
  "gitlens.views.repositories.showIssues": true,
  "gitlens.views.repositories.showWorktrees": true,
  "gitlens.views.repositories.showGraph": true,
  "shellformat.flag": "-i 2",
  "shellformat.path": "shfmt"
}
